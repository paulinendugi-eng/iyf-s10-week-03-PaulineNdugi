🎨 2. style.css
CSS
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
}

/* Navigation */
nav {
    background-color: #333;
    color: white;
    display: flex;
    justify-content: space-between;
    padding: 15px;
    align-items: center;
}

nav ul {
    list-style: none;
    display: flex;
    gap: 15px;
}

nav ul li {
    cursor: pointer;
}

/* Header */
header {
    text-align: center;
    padding: 50px;
    background-color: white;
}

/* Section */
section {
    padding: 30px;
    background-color: white;
    margin: 20px;
}

/* Responsive */
@media (max-width: 768px) {
    nav {
        flex-direction: column;
    }

    nav ul {
        flex-direction: column;
        padding: 0;
    }
}
